# OmniFlow QA - Environment Configuration Template

# Server Port
PORT=5000
NODE_ENV=production

# Base URLs (If running behind reverse proxy, e.g. https://qa.yourcompany.com)
# VITE_API_BASE=https://qa.yourcompany.com/api
# VITE_WS_URL=wss://qa.yourcompany.com

# Jira MCP Integration (Optional)
JIRA_DOMAIN=https://your-company.atlassian.net
JIRA_EMAIL=qa-lead@yourcompany.com
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_PROJECT_KEY=QA
JIRA_BOARD_ID=BOARD-101

# Slack Alert Webhook (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
